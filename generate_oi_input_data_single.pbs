#!/bin/bash
#PBS -j oe
#PBS -m ae
#PBS -M momoe.yoshida@my.jcu.edu.au
#PBS -l walltime=08:00:00
#PBS -l select=1:ncpus=1:mem=64gb
#PBS -o /home/heronlab/momoe/geo_polar_blended_sst/Linux_JCUHPC/blended_home/Logs/tmp.log
#PBS -N generate_oi_input_data_single

cd $PBS_O_WORKDIR

# Add this to all of your scripts
shopt -s expand_aliases
source /etc/profile.d/modules.sh

# Output some useful information about
# the job we are running
echo "Job identifier is $PBS_JOBID"
echo "Working directory is $PBS_O_WORKDIR"

# Load the container we want to use
# It is a good idea to always specify the version number 
module load matlab/2024a

log_dir="/home/heronlab/momoe/geo_polar_blended_sst/Linux_JCUHPC/blended_home/Logs"
log_file="${log_dir}/generate_oi_input_data_${year}_${day}.log"
exec >"$log_file" 2>&1

echo "🚀 Running generate_oi_input_data for Year=${year}, Day=${day} (Yesterday=${yyear},${yday})"
date

# Note: modify init_par_info.m (e.g., thinning switch) if needed
matlab -nodisplay -nosplash -r "try, \
    clear mex; \
    init_files_OSTIA(${yyear},${yday}); \
    init_all_biases(${yyear},${yday}); \
    generate_oi_input_data(${year},${day},'all'); \
catch ME, disp(getReport(ME)); exit(1); end; exit"

echo "✅ Finished ${year}-${day} at $(date)"
